# ===================================================
# MAEDA — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ===================================================

# --- LLM Provider (pick one or both) ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Default model for each agent
MAEDA_LLM_PROVIDER=openai          # openai | anthropic
MAEDA_LLM_MODEL=gpt-4o-mini        # gpt-4o | gpt-4o-mini | claude-3-5-sonnet-20241022
MAEDA_LLM_TEMPERATURE=0.0

# --- Token / Cost Limits ---
MAEDA_MAX_TOKENS_PER_CALL=4096
MAEDA_MAX_COST_PER_SESSION=1.00    # USD; aborts if exceeded

# --- MCP Sub-System URLs ---
DATA_CLEANER_MCP_URL=http://localhost:8001
RAG_SERVER_MCP_URL=http://localhost:8002
# MAEDA_RAG_COLLECTION=wake_apparel  # scope retrieval to one collection; unset = whole KB
MCP_STRICT_MODE=degraded           # strict (CI/联调, never fabricates a result) | degraded (demo, falls back)
DATA_CLEANER_QUALITY_CONTRACT_VERSION=2
DATA_CLEANER_PLANNER_MODE=llm       # rule | llm (llm requires cleaner to have its own LLM key configured; llm is the hard dependency for the integration path, 定案 #6)
MAEDA_ARTIFACT_ROOT=./artifacts/cleaner_runs   # resolved to absolute before being sent to the cleaner (M8)

# --- Sub-system switches (定案 #15; ECOSYSTEM_INTEGRATION_PLAN.md 附录 CC/CD) ---
# Experiment 1 (阶段 4) arms. Both default to "auto" = ordinary behavior.
MAEDA_CLEANER_MODE=auto            # auto | force_on (bypass has_critical_issues itself) | force_off (never call clean_dataset)
MAEDA_RAG_MODE=auto                # auto | force_on | force_off (never call retrieve; records mode="skipped")
# NOTE (附录 CC.7 裁定 4): "auto" for RAG currently always retrieves. The
# conditional route exists (src/graph/router.py::route_after_viz) but the
# judgement that would let auto SKIP retrieval for purely-computational
# queries is deliberately not implemented yet.
# Which retrieval tier a force_on arm asserts it ran at (附录 CK.3). Under
# force_on, a retrieval that came back below this tier, degraded to the
# fallback path, or hard-failed invalidates that trial for aggregation
# instead of being averaged into the on-arm mean.
MAEDA_RAG_EXPECTED_RETRIEVAL_MODE=hybrid   # hybrid (vector retrieval must have run) | bm25_only (declared BM25-only deployment)

# --- Data Sources ---
MAEDA_DEFAULT_DATA_DIR=./data/sample

# --- Logging ---
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                    # json | pretty
LOG_FILE=./logs/maeda.log          # leave blank to log to stdout only

# --- Run persistence (decision_trace / mcp_call_log, see src/persistence/run_store.py) ---
MAEDA_RUNS_DB_PATH=logs/runs.db

# --- Streamlit UI ---
STREAMLIT_PORT=8501

# --- Eval ---
EVAL_ENABLED=true
EVAL_GOLDEN_SUITE=./tests/eval/test_suite.json
# The eval judge deliberately does NOT reuse MAEDA_LLM_MODEL by default —
# scoring an agent's output with a model from the same family is a
# self-preference risk. Leave both unset to auto-resolve: prefers the
# *other* provider if a real key is configured for it, else falls back to
# a stronger model on the same provider (gpt-4o / claude-3-5-sonnet).
# EVAL_LLM_PROVIDER=anthropic        # openai | anthropic — explicit override
# EVAL_MODEL=gpt-4o                  # explicit override
EVAL_JUDGE_SAMPLES=3                 # independent judge calls per check, aggregated by median
