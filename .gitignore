# Environment / secrets
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/

# Caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS
.DS_Store

# Runtime logs (eval reports under logs/eval_runs/ are intentionally kept)
logs/*.log
logs/maeda.log
logs/*.db

# Large / real user-uploaded data — not synthetic demo data, don't publish
data/uploads/

# Streamlit
.streamlit/

# Charts generated at runtime
data/charts/

# Replay cache (src/eval/replay_cache.py) — full pipeline states, tens of MB
# for the golden suite; regenerate locally via scripts/generate_replay_corpus.py
# rather than committing it.
logs/replay_cache/

# scripts/measure_noise.py's cached fixed states for judge-noise mode --
# same idea as logs/replay_cache/ above (large, regeneratable, not itself
# evidence). The actual *_noise_*.json measurement reports in
# logs/noise_runs/ are intentionally kept, same as logs/eval_runs/.
logs/noise_runs/judge_fixed_states.json
